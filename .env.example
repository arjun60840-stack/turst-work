# ===========================
# NEXVION Environment Variables
# ===========================
# Copy this file to .env and fill in values

# Server
PORT=3000
NODE_ENV=development
API_URL=http://localhost:3000

# Database (SQLite for dev, PostgreSQL for production)
DB_CLIENT=sqlite3
DB_FILENAME=./nexvion.db
# For PostgreSQL production:
# DB_CLIENT=pg
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=nexvion
# DB_USER=nexvion_user
# DB_PASSWORD=your_secure_password_here

# JWT
JWT_SECRET=change_this_to_a_random_secret_in_production
JWT_REFRESH_SECRET=change_this_refresh_secret_too
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OTP (DEMO mode for prototype)
OTP_MODE=demo
OTP_DEMO_CODE=123456
# For production SMS:
# OTP_MODE=production
# OTP_PROVIDER=twilio
# TWILIO_SID=your_sid
# TWILIO_AUTH_TOKEN=your_token
# TWILIO_PHONE=+1234567890

# Payment (DEMO mode for prototype)
PAYMENT_MODE=demo
# For production:
# PAYMENT_MODE=production
# PAYMENT_PROVIDER=razorpay
# RAZORPAY_KEY_ID=your_key
# RAZORPAY_KEY_SECRET=your_secret

# File Storage
STORAGE_MODE=local
UPLOAD_DIR=./uploads
# For production S3:
# STORAGE_MODE=s3
# AWS_S3_BUCKET=nexvion-uploads
# AWS_ACCESS_KEY_ID=your_key
# AWS_SECRET_ACCESS_KEY=your_secret
# AWS_REGION=ap-south-1

# Admin
ADMIN_EMAIL=admin@nexvion.demo
ADMIN_PASSWORD=NexvionAdmin@2026

# Matching Engine
MATCH_WEIGHT_SKILL=0.30
MATCH_WEIGHT_AVAILABILITY=0.15
MATCH_WEIGHT_DISTANCE=0.15
MATCH_WEIGHT_RELIABILITY=0.15
MATCH_WEIGHT_EXPERIENCE=0.10
MATCH_WEIGHT_RATING=0.05
MATCH_WEIGHT_VERIFICATION=0.05
MATCH_WEIGHT_WAGE=0.05

# Max service radius in km
MAX_SERVICE_RADIUS_KM=50

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
